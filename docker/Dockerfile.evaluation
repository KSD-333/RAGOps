# ==============================================================================
# RAGOps Evaluation Service Dockerfile
# ==============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir hatchling && \
    pip install --no-cache-dir .

# ------------------------------------------------------------------------------
# Final Runtime Stage
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS runner

WORKDIR /app

RUN groupadd -g 1001 ragops && \
    useradd -u 1001 -g ragops -s /bin/sh ragops && \
    mkdir -p /app/data /app/evaluation /app/evaluation/reports && \
    chown -R ragops:ragops /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --chown=ragops:ragops src /app/src
COPY --chown=ragops:ragops configs /app/configs
COPY --chown=ragops:ragops evaluation /app/evaluation
COPY --chown=ragops:ragops scripts /app/scripts
COPY --chown=ragops:ragops pyproject.toml /app/

ENV PYTHONPATH="/app/src:${PYTHONPATH}"
ENV PYTHONUNBUFFERED=1

USER ragops

ENTRYPOINT ["python", "scripts/run_evaluation.py"]
CMD ["--dataset", "evaluation/datasets/golden.jsonl", "--fail-on-gate"]
