# ==============================================================================
# RAGOps API Service Dockerfile
# Multi-stage build for lightweight, secure production deployment
# ==============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir hatchling && \
    pip install --no-cache-dir .

# ------------------------------------------------------------------------------
# Final Runtime Stage
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS runner

WORKDIR /app

# Create non-root system user for security
RUN groupadd -g 1001 ragops && \
    useradd -u 1001 -g ragops -s /bin/sh ragops && \
    mkdir -p /app/data /app/data/chroma /app/logs && \
    chown -R ragops:ragops /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --chown=ragops:ragops src /app/src
COPY --chown=ragops:ragops configs /app/configs
COPY --chown=ragops:ragops pyproject.toml /app/

# Install the local package in editable mode or ensure PYTHONPATH includes src
ENV PYTHONPATH="/app/src:${PYTHONPATH}"
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

USER ragops

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["uvicorn", "ragops.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
